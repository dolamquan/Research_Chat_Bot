{
  "manifest_version": 3,
  "name": "Zoetrope Paper Capture",
  "version": "0.2.0",
  "description": "Send the current arXiv or PDF page to your Zoetrope library, as the account signed in to the app.",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8002/*",
    "http://localhost:8002/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Add paper to Zoetrope",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
