# Install as /etc/zoetrope/zoetrope.env (not in the Git working tree).
# Use the real public HTTPS URL everywhere shown below.
LLM_PROVIDER=openai
OPENAI_API_KEY=replace_me
OPENAI_MODEL=

AUTH_MODE=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
CORS_ORIGINS=https://your-domain.example
FRONTEND_URL=https://your-domain.example

# This is the public URL, though Caddy proxies it internally to FastAPI.
NOTION_REDIRECT_URI=https://your-domain.example/api/integrations/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
INTEGRATION_SECRET_KEY=

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Copy the remaining provider/integration values you use from
# backend/.env.example. Do not enable Docker-backed MCP tools unless you have
# deliberately decided how the API service will access Docker.
