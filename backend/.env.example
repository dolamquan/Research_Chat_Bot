# --- LLM provider ------------------------------------------------------------
# Which provider builds chat models. Leave unset for the historical default
# (openai), which keeps existing behaviour unchanged.
LLM_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
# Optional. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=

# Only needed when LLM_PROVIDER=anthropic. Requires `pip install langchain-anthropic`.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-5 when unset.
ANTHROPIC_MODEL=

# --- Accounts ----------------------------------------------------------------
# Sign-in is handled by Supabase Auth; this backend only verifies the session
# tokens it issues, against the project's public JWKS. No Supabase secret key
# is needed here. AUTH_MODE=disabled skips sign-in and acts as one local admin
# (development only). CORS_ORIGINS matters only when the browser talks to the
# API directly instead of through the Vite proxy.
SUPABASE_URL=https://<project-ref>.supabase.co
AUTH_MODE=supabase
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Encrypts users' Notion/GitHub credentials at rest. Any Fernet key
# (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Leave empty to auto-generate one into backend/app/data/integration.key.
# NOTION_API_KEY / GITHUB_TOKEN below remain the administrator's defaults.
INTEGRATION_SECRET_KEY=

# Notion sign-in ("Connect Notion" in the Notes view). Create a public/OAuth
# connection at https://www.notion.so/profile/integrations with this redirect
# URI (Notion refuses IP addresses, hence localhost). FRONTEND_URL is where the
# browser returns after consent.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8002/integrations/notion/callback
FRONTEND_URL=http://127.0.0.1:5173

# --- Agent tab ---------------------------------------------------------------
# The Agent tab runs a tool-calling loop over every application route, MCP
# tool and library helper. AGENT_MODEL overrides the provider's default model
# for it (needs function calling). AGENT_MAX_STEPS caps model turns per
# request. AGENT_MODE=legacy restores the old fixed intent router.
AGENT_MODEL=
AGENT_MAX_STEPS=8
AGENT_MODE=tools

# --- Assistant (voice dock, websocket /agent/ws) -----------------------------
# Same model and tools as the Agent tab, streamed. ASSISTANT_MAX_STEPS falls
# back to AGENT_MAX_STEPS. CLIENT_TOOL_TIMEOUT is how long the server waits
# for the browser to finish a screen action; CONFIRMATION_TTL is how long a
# parked destructive action waits for the user's yes; HISTORY_LIMIT is how
# many past messages each turn replays.
ASSISTANT_MAX_STEPS=
ASSISTANT_CLIENT_TOOL_TIMEOUT=20
ASSISTANT_CONFIRMATION_TTL=600
ASSISTANT_HISTORY_LIMIT=12

# Voice input uses gpt-live-transcribe via /agent/transcribe and OPENAI_API_KEY.
# Separate from AGENT_MODEL/LLM_PROVIDER. Unmuted wake-word listening sends
# detected speech (billable); silence is gated and mute closes the connection.
ASSISTANT_TRANSCRIPTION_LANGUAGES=en
ASSISTANT_TRANSCRIPTION_DELAY=low

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Exact LLM prompt-response cache for repeated deterministic calls.
# This complements provider-side prompt caching and can be disabled while debugging.
LLM_RESPONSE_CACHE_ENABLED=true
LLM_RESPONSE_CACHE_TTL_SECONDS=86400
LLM_RESPONSE_CACHE_PATH=

# Optional external MCP-style tools
PAPER_SEARCH_BACKEND=auto
PAPER_SEARCH_DOCKER_IMAGE=mcp/paper-search
PAPER_SEARCH_DOCKER_ENTRYPOINT=python
PAPER_SEARCH_DOCKER_MODULE=paper_search_mcp.cli
PAPER_SEARCH_TIMEOUT_SECONDS=90
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
PUBMED_EMAIL=
NCBI_API_KEY=
OPENALEX_EMAIL=
CORE_API_KEY=
DOAJ_API_KEY=
UNPAYWALL_EMAIL=

# Optional Reddit MCP Docker bridge. Read-only search is used by Zoetrope.
REDDIT_MCP_BACKEND=docker
REDDIT_MCP_DOCKER_IMAGE=mcp/reddit
REDDIT_MCP_TIMEOUT_SECONDS=60
REDDIT_MCP_SEARCH_TOOL=
REDDIT_USERNAME=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=Zoetrope/0.1

# Notion export. Databases are registered per-workspace from the Notes view
# ("Notion" button); NOTION_DATABASE_ID is only the fallback when no target is
# registered, and NOTION_TITLE_PROPERTY is only used when schema introspection
# cannot find the title property.
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository

# --- Scene composition -------------------------------------------------------
# The per-stage animation composer runs separately from extraction: choosing a
# cast and choreographing it rewards a stronger model, while extraction wants a
# cheap deterministic one. Leave unset to use the defaults below.
VISUALIZER_SCENE_MODEL=gpt-4o
VISUALIZER_SCENE_TEMPERATURE=0.35

# --- Cloud data (optional) ----------------------------------------------------
# Leave all of these empty to keep every store on the SQLite files, the PDFs in
# app/data/uploaded_docs and vectors in the local Qdrant container.
#
# DATABASE_URL moves the 13 tables to Postgres. Use Supabase's *pooled*
# connection string (Project Settings > Database > Connection pooling, port
# 6543, transaction mode). DATABASE_POOL_SIZE caps this process's connections.
DATABASE_URL=
DATABASE_POOL_SIZE=8
# SUPABASE_SERVICE_ROLE_KEY lets the backend keep the PDFs in a private Storage
# bucket (uploaded_docs becomes a cache). Never ship this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=papers
# Vectors already follow QDRANT_URL / QDRANT_API_KEY above; point them at a
# Qdrant Cloud cluster after copying with scripts/migrate_to_cloud.py.
# One-off migration targets (only read by scripts/migrate_to_cloud.py):
TARGET_QDRANT_URL=
TARGET_QDRANT_API_KEY=
