# --- LLM provider ------------------------------------------------------------
# Which provider builds chat models. Leave unset for the historical default
# (openai), which keeps existing behaviour unchanged.
LLM_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
# Optional. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=

# Only needed when LLM_PROVIDER=anthropic. Requires `pip install langchain-anthropic`.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-5 when unset.
ANTHROPIC_MODEL=

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Exact LLM prompt-response cache for repeated deterministic calls.
# This complements provider-side prompt caching and can be disabled while debugging.
LLM_RESPONSE_CACHE_ENABLED=true
LLM_RESPONSE_CACHE_TTL_SECONDS=86400
LLM_RESPONSE_CACHE_PATH=

# Optional external MCP-style tools
PAPER_SEARCH_BACKEND=auto
PAPER_SEARCH_DOCKER_IMAGE=mcp/paper-search
PAPER_SEARCH_DOCKER_ENTRYPOINT=python
PAPER_SEARCH_DOCKER_MODULE=paper_search_mcp.cli
PAPER_SEARCH_TIMEOUT_SECONDS=90
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
PUBMED_EMAIL=
NCBI_API_KEY=
OPENALEX_EMAIL=
CORE_API_KEY=
DOAJ_API_KEY=
UNPAYWALL_EMAIL=

# Optional Reddit MCP Docker bridge. Read-only search is used by Zoetrope.
REDDIT_MCP_BACKEND=docker
REDDIT_MCP_DOCKER_IMAGE=mcp/reddit
REDDIT_MCP_TIMEOUT_SECONDS=60
REDDIT_MCP_SEARCH_TOOL=
REDDIT_USERNAME=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=Zoetrope/0.1

# Notion export. Databases are registered per-workspace from the Notes view
# ("Notion" button); NOTION_DATABASE_ID is only the fallback when no target is
# registered, and NOTION_TITLE_PROPERTY is only used when schema introspection
# cannot find the title property.
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository

# --- Scene composition -------------------------------------------------------
# The per-stage animation composer runs separately from extraction: choosing a
# cast and choreographing it rewards a stronger model, while extraction wants a
# cheap deterministic one. Leave unset to use the defaults below.
VISUALIZER_SCENE_MODEL=gpt-4o
VISUALIZER_SCENE_TEMPERATURE=0.35
